{
  "about": "Shared loop-detection scenarios. baar-core and noburn's SDK must give the same verdicts: which steps warn, and whether the next call is refused (and as which pattern). Copy this file to the other repo unchanged.",
  "scenarios": [
    {"name": "third identical call is refused",
     "steps": [{"tool": "search", "args": {"q": "acme revenue"}, "result": "No results"},
               {"tool": "search", "args": {"q": "acme revenue"}, "result": "No results"}],
     "next": {"tool": "search", "args": {"q": "acme revenue"}},
     "expect": {"warn_steps": [1], "stop": "repeat"}},
    {"name": "a changed argument goes through",
     "steps": [{"tool": "search", "args": {"q": "acme revenue"}, "result": "No results"},
               {"tool": "search", "args": {"q": "acme revenue"}, "result": "No results"}],
     "next": {"tool": "search", "args": {"q": "acme 2025 annual report"}},
     "expect": {"warn_steps": [1], "stop": null}},
    {"name": "custom max_repeats",
     "options": {"max_repeats": 4},
     "steps": [{"tool": "s", "args": {}, "result": "r"}, {"tool": "s", "args": {}, "result": "r"},
               {"tool": "s", "args": {}, "result": "r"}, {"tool": "s", "args": {}, "result": "r"}],
     "next": {"tool": "s", "args": {}},
     "expect": {"warn_steps": [3], "stop": "repeat"}},
    {"name": "progress is not a loop",
     "steps": [{"tool": "job", "args": {"id": 1}, "result": "queued"},
               {"tool": "job", "args": {"id": 1}, "result": {"status": "running", "pct": 10}},
               {"tool": "job", "args": {"id": 1}, "result": {"status": "running", "pct": 60}},
               {"tool": "job", "args": {"id": 1}, "result": "done"}],
     "next": {"tool": "job", "args": {"id": 1}},
     "expect": {"warn_steps": [], "stop": null}},
    {"name": "waiting on a job is not a loop",
     "steps": [{"tool": "job", "args": {"id": 1}, "result": "running"},
               {"tool": "job", "args": {"id": 1}, "result": "running"},
               {"tool": "job", "args": {"id": 1}, "result": "running"},
               {"tool": "job", "args": {"id": 1}, "result": {"status": "pending"}},
               {"tool": "job", "args": {"id": 1}, "result": "Booting the worker..."}],
     "next": {"tool": "job", "args": {"id": 1}},
     "expect": {"warn_steps": [], "stop": null}},
    {"name": "in_progress=false counts waiting",
     "options": {"in_progress": false},
     "steps": [{"tool": "job", "args": {"id": 1}, "result": "running"},
               {"tool": "job", "args": {"id": 1}, "result": "running"}],
     "next": {"tool": "job", "args": {"id": 1}},
     "expect": {"warn_steps": [1], "stop": "repeat"}},
    {"name": "a long result that mentions running still counts",
     "steps": [{"tool": "search", "args": {"q": "shoes"}, "result": "LONG_RUNNING_PAGE"},
               {"tool": "search", "args": {"q": "shoes"}, "result": "LONG_RUNNING_PAGE"}],
     "next": {"tool": "search", "args": {"q": "shoes"}},
     "expect": {"warn_steps": [1], "stop": "repeat"}},
    {"name": "same error three times in a row",
     "steps": [{"tool": "deploy", "args": {}, "error": "missing config"},
               {"tool": "deploy", "args": {}, "error": "missing config"},
               {"tool": "deploy", "args": {}, "error": "missing config"}],
     "next": {"tool": "deploy", "args": {}},
     "expect": {"warn_steps": [2], "stop": "error"}},
    {"name": "flaky is not stuck",
     "steps": [{"tool": "api", "args": {}, "error": "503"}, {"tool": "api", "args": {}, "result": "ok 1"},
               {"tool": "api", "args": {}, "error": "503"}, {"tool": "api", "args": {}, "result": "ok 2"},
               {"tool": "api", "args": {}, "error": "503"}],
     "next": {"tool": "api", "args": {}},
     "expect": {"warn_steps": [], "stop": null}},
    {"name": "ping-pong",
     "options": {"max_repeats": 10},
     "steps": [{"tool": "a", "args": {}, "result": "1"}, {"tool": "b", "args": {}, "result": "2"},
               {"tool": "a", "args": {}, "result": "1"}, {"tool": "b", "args": {}, "result": "2"},
               {"tool": "a", "args": {}, "result": "1"}, {"tool": "b", "args": {}, "result": "2"}],
     "next": {"tool": "a", "args": {}},
     "expect": {"warn_steps": [5], "stop": "ping_pong"}},
    {"name": "exempt tools never count",
     "options": {"exempt_tools": ["poll"]},
     "steps": [{"tool": "poll", "args": {}, "result": "same"}, {"tool": "poll", "args": {}, "result": "same"},
               {"tool": "poll", "args": {}, "result": "same"}],
     "next": {"tool": "poll", "args": {}},
     "expect": {"warn_steps": [], "stop": null}},
    {"name": "ignored arguments",
     "options": {"ignore_args": ["request_id"]},
     "steps": [{"tool": "fetch", "args": {"url": "x", "request_id": "a1"}, "result": "same"},
               {"tool": "fetch", "args": {"url": "x", "request_id": "b2"}, "result": "same"}],
     "next": {"tool": "fetch", "args": {"url": "x", "request_id": "c3"}},
     "expect": {"warn_steps": [1], "stop": "repeat"}},
    {"name": "JSON-string arguments equal dict arguments",
     "steps": [{"tool": "search", "args": "{\"q\": \"x\", \"n\": 1}", "result": "none"},
               {"tool": "search", "args": {"n": 1, "q": "x"}, "result": "none"}],
     "next": {"tool": "search", "args": "{\"q\":\"x\",\"n\":1}"},
     "expect": {"warn_steps": [1], "stop": "repeat"}},
    {"name": "whitespace in arguments is normalized",
     "steps": [{"tool": "shell", "args": {"cmd": "ls  -la"}, "result": "same"},
               {"tool": "shell", "args": {"cmd": "ls -la "}, "result": "same"}],
     "next": {"tool": "shell", "args": {"cmd": " ls -la"}},
     "expect": {"warn_steps": [1], "stop": "repeat"}},
    {"name": "a first error is not a warning",
     "options": {"max_error_repeats": 2},
     "steps": [{"tool": "x", "args": {}, "error": "boom"}],
     "next": {"tool": "x", "args": {}},
     "expect": {"warn_steps": [], "stop": null}}
  ]
}
